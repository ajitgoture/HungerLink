import { useTranslation } from "react-i18next";
import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { Upload, X, MapPin, AlertCircle, Clock } from 'lucide-react';
import api from '../../services/api';
import { useAuth } from '../../context/AuthContext';
import { useNotifications } from '../../context/NotificationContext';
import { validateDonationDates, validateQuantity } from '../../utils/donationValidation';
import { Button, Input, Select, Textarea, Card, CardHeader, CardTitle, CardContent } from '../../components/ui';
const DonateClothForm = () => {
  const { t, i18n } = useTranslation();
  
  
  const {
    user
  } = useAuth();
  const navigate = useNavigate();
  const {
    showToast
  } = useNotifications();
  React.useEffect(() => {
    if (user && !['Cloth Donor', 'Clothes Donor', 'donor'].includes(user.role)) {
      showToast(t('toastTitle_accessDenied'), t('toastMsg_onlyClothDonorsCanPostClothesDonations'));
      navigate('/dashboard');
    }
  }, [user, navigate, showToast]);
  const [formData, setFormData] = useState({
    clothingCategory: 'Unisex',
    clothingType: 'Shirt',
    customClothingType: '',
    gender: 'Unisex',
    ageGroup: 'Adults',
    size: 'M',
    quantity: '',
    condition: 'Good',
    season: 'All Season',
    description: '',
    availableFrom: '',
    pickupDate: '',
    pickupTimeWindow: 'Flexible',
    expiryTime: '',
    responseDeadline: '',
    city: user?.city || '',
    area: '',
    pickupAddress: user?.address || '',
    lat: user?.location?.lat || 40.7128,
    lng: user?.location?.lng || -74.006,
    contactNumber: user?.phone || '',
    qualityAcknowledged: false
  });
  const [imageFiles, setImageFiles] = useState([]);
  const [imagePreviews, setImagePreviews] = useState([]);
  const [submitting, setSubmitting] = useState(false);
  const [errors, setErrors] = useState([]);
  const handleChange = e => {
    const {
      name,
      value
    } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
  };
  const handleImageChange = e => {
    const files = Array.from(e.target.files);
    if (files.length + imageFiles.length > 5) {
      showToast(t('toastTitle_limitReached'), t('toastMsg_youCanOnlyUploadUpTo5Images'));
      return;
    }
    files.forEach(file => {
      if (file.size > 5 * 1024 * 1024) {
        showToast(t('toastTitle_fileTooLarge'), t('toastMsg_fileNameIsOver5mb'));
        return;
      }
      if (!file.type.startsWith('image/')) {
        showToast(t('toastTitle_invalidFile'), t('toastMsg_fileNameIsNotAValidImage'));
        return;
      }
      setImageFiles(prev => [...prev, file]);
      const reader = new FileReader();
      reader.onloadend = () => setImagePreviews(prev => [...prev, reader.result]);
      reader.readAsDataURL(file);
    });
  };
  const removeImage = index => {
    setImageFiles(prev => prev.filter((_, i) => i !== index));
    setImagePreviews(prev => prev.filter((_, i) => i !== index));
  };
  const handleSubmit = async e => {
    e.preventDefault();
    setErrors([]);
    const validationErrors = validateDonationDates(formData.availableFrom, formData.expiryTime, formData.responseDeadline);
    const qErr = validateQuantity(formData.quantity, 'Quantity');
    if (qErr) validationErrors.push(qErr);
    if (validationErrors.length > 0) {
      setErrors(validationErrors);
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
      return;
    }
    try {
      setSubmitting(true);
      const submitData = new FormData();

      // Explicitly append only accepted backend fields
      const allowedFields = ['clothingCategory', 'clothingType', 'customClothingType', 'gender', 'ageGroup', 'quantity', 'size', 'condition', 'season', 'description', 'availableFrom', 'pickupDate', 'pickupTimeWindow', 'expiryTime', 'responseDeadline', 'city', 'area', 'pickupAddress', 'lat', 'lng', 'contactNumber', 'qualityAcknowledged'];
      allowedFields.forEach(key => {
        if (formData[key] !== undefined && formData[key] !== null) {
          submitData.append(key, formData[key]);
        }
      });
      imageFiles.forEach(file => {
        submitData.append('images', file);
      });
      await api.post('/cloth/donations', submitData, {
        headers: {
          'Content-Type': 'multipart/form-data'
        }
      });
      showToast(t('toastTitle_success'), t('toastMsg_clothesDonationPostedSuccessfully'));
      navigate('/cloth/donor-dashboard');
    } catch (err) {
      setErrors([err.response?.data?.message || 'Failed to post donation']);
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    } finally {
      setSubmitting(false);
    }
  };
  return <div className="min-h-screen bg-slate-50 py-10 px-4 sm:px-6 lg:px-8">
      <div className="max-w-4xl mx-auto space-y-8">
        
        <div className="text-center space-y-2">
          <h1 className="text-3xl font-black text-slate-900">{t("Post Clothes Donation")}</h1>
          <p className="text-sm text-slate-500">{t("List unused clothes to help someone stay warm and confident.")}</p>
        </div>

        {errors.length > 0 && <div className="bg-red-50 border border-red-200 rounded-2xl p-4 space-y-2">
            <div className="flex items-center gap-2 text-red-800 font-bold text-sm">
              <AlertCircle className="w-5 h-5" /> {t("Please fix the following errors:")}
            </div>
            <ul className="list-disc list-inside text-xs text-red-600 pl-2">
              {errors.map((err, i) => <li key={i}>{err}</li>)}
            </ul>
          </div>}

        <form onSubmit={handleSubmit} className="space-y-6">
          
          {/* SECTION 1: Cloth Details */}
          <Card>
            <CardHeader><CardTitle>{t("1. Clothing Details")}</CardTitle></CardHeader>
            <CardContent className="space-y-5">
              
              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <Select label={t("Category *")} name="clothingCategory" value={formData.clothingCategory} onChange={handleChange} options={[{
                value: 'Men',
                label: 'Men'
              }, {
                value: 'Women',
                label: 'Women'
              }, {
                value: 'Children',
                label: 'Children'
              }, {
                value: 'Unisex',
                label: 'Unisex'
              }]} required />
                <Select label={t("Type *")} name="clothingType" value={formData.clothingType} onChange={handleChange} options={['Shirt', 'T-Shirt', 'Pants', 'Jeans', 'Dress', 'Saree', 'Salwar Suit', 'Kurta', 'Jacket', 'Sweater', 'Coat', 'Shorts', 'Skirt', 'School Uniform', 'Baby Clothes', 'Other'].map(v => ({
                value: v,
                label: v
              }))} required />
              </div>

              {formData.clothingType === 'Other' && <Input label={t("Specify Type *")} name="customClothingType" value={formData.customClothingType} onChange={handleChange} required />}

              <div className="grid grid-cols-2 md:grid-cols-4 gap-5">
                <Select label={t("Gender")} name="gender" value={formData.gender} onChange={handleChange} options={[{
                value: 'Men',
                label: 'Men'
              }, {
                value: 'Women',
                label: 'Women'
              }, {
                value: 'Unisex',
                label: 'Unisex'
              }, {
                value: 'Boys',
                label: 'Boys'
              }, {
                value: 'Girls',
                label: 'Girls'
              }]} />
                <Select label={t("Age Group")} name="ageGroup" value={formData.ageGroup} onChange={handleChange} options={[{
                value: 'Infants',
                label: 'Infants'
              }, {
                value: 'Kids',
                label: 'Kids'
              }, {
                value: 'Teens',
                label: 'Teens'
              }, {
                value: 'Adults',
                label: 'Adults'
              }, {
                value: 'Elderly',
                label: 'Elderly'
              }]} />
                <Select label={t("Size *")} name="size" value={formData.size} onChange={handleChange} options={['XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL', 'Free Size', 'Other'].map(v => ({
                value: v,
                label: v
              }))} required />
                <Input label={t("Quantity *")} type="number" name="quantity" value={formData.quantity} onChange={handleChange} min="1" required />
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <Select label={t("Condition *")} name="condition" value={formData.condition} onChange={handleChange} options={[{
                value: 'New',
                label: 'New (With Tags)'
              }, {
                value: 'Like New',
                label: 'Like New'
              }, {
                value: 'Good',
                label: 'Good'
              }, {
                value: 'Usable',
                label: 'Usable'
              }]} required />
                <Select label={t("Season *")} name="season" value={formData.season} onChange={handleChange} options={[{
                value: 'Summer',
                label: 'Summer Wear'
              }, {
                value: 'Winter',
                label: 'Winter Wear'
              }, {
                value: 'All Season',
                label: 'All Season'
              }]} required />
              </div>

              <Textarea label={t("Description (Optional)")} name="description" value={formData.description} onChange={handleChange} placeholder={t("Any specific details?")} rows={3} />
            </CardContent>
          </Card>

          {/* SECTION 2: Image Upload */}
          <Card>
            <CardHeader><CardTitle>{t("2. Images (Up to 5)")}</CardTitle></CardHeader>
            <CardContent>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {imagePreviews.map((src, index) => <div key={index} className="relative aspect-square rounded-2xl overflow-hidden border border-slate-200">
                    <img src={src} alt={t("Preview")} className="w-full h-full object-cover" />
                    <button type="button" onClick={() => removeImage(index)} className="absolute top-2 right-2 p-1 bg-white/90 text-red-600 rounded-full hover:bg-red-50 transition">
                      <X className="w-4 h-4" />
                    </button>
                  </div>)}
                
                {imageFiles.length < 5 && <label className="flex flex-col items-center justify-center aspect-square border-2 border-dashed border-slate-300 rounded-2xl cursor-pointer bg-slate-50 hover:bg-slate-100 transition">
                    <Upload className="w-6 h-6 text-slate-400 mb-2" />
                    <span className="text-xs font-semibold text-slate-600">{t("Add Image")}</span>
                    <input type="file" className="hidden" accept="image/*" multiple onChange={handleImageChange} />
                  </label>}
              </div>
            </CardContent>
          </Card>

          {/* SECTION 3: Timelines */}
          <Card>
            <CardHeader><CardTitle className="flex items-center gap-2"><Clock className="w-5 h-5" /> {t("3. Availability Timelines")}</CardTitle></CardHeader>
            <CardContent className="space-y-5">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <Input label={t("Available For Pickup From *")} type="datetime-local" name="availableFrom" value={formData.availableFrom} onChange={handleChange} required />
                <Select label={t("Preferred Time Window")} name="pickupTimeWindow" value={formData.pickupTimeWindow} onChange={handleChange} options={[{
                value: 'Flexible',
                label: 'Flexible'
              }, {
                value: 'Morning (8AM-12PM)',
                label: 'Morning (8AM-12PM)'
              }, {
                value: 'Afternoon (12PM-4PM)',
                label: 'Afternoon (12PM-4PM)'
              }, {
                value: 'Evening (4PM-8PM)',
                label: 'Evening (4PM-8PM)'
              }]} />
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <Input label={t("Expiry Time (Listing removal) *")} type="datetime-local" name="expiryTime" value={formData.expiryTime} onChange={handleChange} required />
                <Input label={t("Response Deadline (Auto-assigned) *")} type="datetime-local" name="responseDeadline" value={formData.responseDeadline} onChange={handleChange} required />
              </div>
            </CardContent>
          </Card>

          {/* SECTION 4: Location */}
          <Card>
            <CardHeader><CardTitle className="flex items-center gap-2"><MapPin className="w-5 h-5" /> {t("4. Pickup Location")}</CardTitle></CardHeader>
            <CardContent className="space-y-5">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
                <Input label={t("City *")} name="city" value={formData.city} onChange={handleChange} required />
                <Input label={t("Neighborhood / Area")} name="area" value={formData.area} onChange={handleChange} />
              </div>
              <Textarea label={t("Precise Pickup Address *")} name="pickupAddress" value={formData.pickupAddress} onChange={handleChange} placeholder={t("This will only be revealed to the receiver you accept.")} rows={2} required />
              <Input label={t("Contact Number *")} name="contactNumber" value={formData.contactNumber} onChange={handleChange} required />
            </CardContent>
          </Card>

          {/* SECTION 6: Quality Acknowledgement */}
          <Card>
            <CardHeader><CardTitle className="flex items-center gap-2"><AlertCircle className="w-5 h-5 text-indigo-500" /> {t("6. Clothing Quality Acknowledgement")}</CardTitle></CardHeader>
            <CardContent>
              <label className="flex items-start gap-3 p-4 bg-indigo-50 border border-indigo-200 rounded-xl cursor-pointer">
                <input type="checkbox" name="qualityAcknowledged" checked={formData.qualityAcknowledged} onChange={e => setFormData({
                ...formData,
                qualityAcknowledged: e.target.checked
              })} className="mt-1 w-5 h-5 text-indigo-600 focus:ring-indigo-500 border-indigo-300 rounded" required />
                <div className="text-sm text-indigo-900">
                  <p className="font-bold mb-1">{t("I acknowledge and guarantee that:")}</p>
                  <ul className="list-disc pl-4 space-y-1 text-indigo-800">
                    <li>{t("All donated clothes have been properly washed and are completely clean.")}</li>
                    <li>{t("There are no permanent stains, unrepairable tears, or hygiene issues.")}</li>
                    <li>{t("The condition stated above perfectly matches the actual physical items.")}</li>
                    <li>{t("I accept full responsibility for the quality of the donated clothing.")}</li>
                  </ul>
                </div>
              </label>
            </CardContent>
          </Card>

          <Button type="submit" size="lg" disabled={!formData.qualityAcknowledged} className="w-full text-lg py-4 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed" isLoading={submitting}>
            {submitting ? 'Posting Donation...' : 'Post Clothes Donation'}
          </Button>

        </form>
      </div>
    </div>;
};
export default DonateClothForm;